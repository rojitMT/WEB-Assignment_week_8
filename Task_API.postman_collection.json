						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Learn REST API\",\n    \"description\": \"Completed Express assignment\",\n    \"completed\": true\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/tasks/{{taskId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"tasks",
								"{{taskId}}"
							]
						},
						"description": "Update an existing task's title, description, or completed status."
